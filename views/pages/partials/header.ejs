<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zaro ILORSAINT's blog</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/fontawsome/css/all.min.css">
    <link rel="stylesheet" href="/fontawsome/css/fontawesome.min.css">
    <script src="/js/script.js" defer></script>
</head>

<body>

    <div class="mobileHeader" id="mobileHeader">
        <div class="icons"><i class="fa-solid fa-bars"></i></div>
    </div>

    <div class="sideBar" id="sideBar">
        <div class="container-icon">
            <span class="icons" id="close"><i class="fa-solid fa-x"></i></span>
        </div>

        <ul class="item">
            <li><a href="/accueil">Accueil</a></li>
            <li><a href="/posts">Posts</a></li>
            <li><a href="/nouveau_post">Nouveau post</a></li>
            <% if (locals.user) { %>
                <li><a href="/deconnexion">Déconnecter</a></li>
            <% } else { %>
                <li><a href="/enregistrer">Enregistrer</a></li>
                <li><a href="/connecter">Connecter</a></li>
            <% } %>
        </ul>
    </div>

    <header>
        <nav>
            <ul>
                <li class="empty"></li>
                <li><a href="/accueil">Accueil</a></li>
                <li><a href="/posts">Posts</a></li>
                <li><a href="/nouveau_post">Nouveau post</a></li>
                <% if (locals.user) { %>
                    <li><a href="/deconnexion">Déconnecter</a></li>
                <% } else { %>
                    <li><a href="/enregistrer">Enregistrer</a></li>
                    <li><a href="/connecter">Connecter</a></li>
                <% } %>
            </ul>
        </nav>
    </header>